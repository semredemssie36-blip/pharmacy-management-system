# Server environment
NODE_ENV=development
PORT=5000

# Client (allowed CORS origin)
CLIENT_URL=http://localhost:5173

# MySQL database configuration (no real secrets in this file)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=pharmacy_erp
DATABASE_USER=your_db_user
DATABASE_PASSWORD=your_db_password

# Authentication
# REQUIRED in production. Use a long random value.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h
AUTH_COOKIE_NAME=pharmacy_erp_auth
# 'lax' or 'strict' for same-site; 'none' only when truly cross-site
AUTH_COOKIE_SAME_SITE=lax
# 'true' in production (HTTPS)
AUTH_COOKIE_SECURE=false
